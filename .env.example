# ============================================================
# Database Configuration (PostgreSQL Docker)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=udpvecsmart_db
POSTGRES_PORT=5432

# ============================================================
# pgAdmin (Web GUI) Configuration (Optional for Development)
# ============================================================
PGADMIN_EMAIL=admin@udpvecsmart.com
PGADMIN_PASSWORD=your_secure_pgadmin_password
PGADMIN_PORT=5050

# ============================================================
# Backend API & Security Configuration
# ============================================================
PORT=5000
NODE_ENV=production

# Database Connection URL for Prisma
# สำหรับ Docker Production ให้เชื่อมต่อไปยัง Service ชื่อ 'postgres:5432' ใน Docker Network
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@postgres:5432/udpvecsmart_db?schema=public"

# ความปลอดภัย JWT Secret (สุ่มสตริงความยาว 32+ ตัวอักษร)
JWT_SECRET=super_secret_jwt_key_change_me_to_random_32_characters
JWT_EXPIRES_IN=7d

# โดเมนที่อนุญาตให้เรียก API (CORS) เช่น https://vecsmart.udpvec.go.th
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Cloudflare Tunnel Configuration (Optional)
# ============================================================
# นำ Token ที่ได้จาก Cloudflare Zero Trust Dashboard มาใส่ตรงนี้
CLOUDFLARE_TUNNEL_TOKEN=

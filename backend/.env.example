PORT=5000
NODE_ENV=production
# สำหรับ Docker Production ให้เชื่อมต่อไปยัง 'postgres:5432' (หากรัน Local ใช้ localhost:5432)
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/udpvecsmart_db?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN   // ผู้ดูแลระบบส่วนกลาง (สอจ.อุดรธานี)
  SCHOOL_ADMIN  // ผู้ดูแลระบบประจำสถานศึกษา
}

enum InstitutionType {
  PUBLIC   // สถานศึกษาภาครัฐ
  PRIVATE  // สถานศึกษาภาคเอกชน
}

enum NewsCategory {
  ANNOUNCEMENT  // ข่าวประชาสัมพันธ์ทั่วไป
  BANNER_SLIDE  // แบนเนอร์สไลด์หน้าแรก
  ACTIVITY      // ข่าวกิจกรรม / ผลงาน
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  fullName      String
  role          Role         @default(SCHOOL_ADMIN)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  news          News[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users")
}

model Institution {
  id          String          @id @default(uuid())
  code        String          @unique // รหัสสถานศึกษา 10 หลัก
  name        String          // ชื่อสถานศึกษา
  type        InstitutionType @default(PUBLIC)
  logoUrl     String?
  website     String?
  phone       String?
  address     String?
  province    String          @default("อุดรธานี")
  programsCount Int           @default(12) // จำนวนสาขาวิชาที่เปิดสอน
  programsList  String?       @db.Text     // รายชื่อสาขาวิชาที่เปิดสอน (JSON array)
  programsUrl   String?                    // ลิงก์รายละเอียดหลักสูตร/สาขาวิชา
  users            User[]
  personnels       Personnel[]
  schoolStats      SchoolStat[]
  dveDepartments   DveDepartment[]
  careerClassrooms CareerClassroom[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("institutions")

}

model Personnel {
  id            String      @id @default(uuid())
  name          String      // ชื่อ-นามสกุล ผู้บริหาร
  position      String      // ตำแหน่ง เช่น ผู้อำนวยการ, รองผู้อำนวยการ
  order         Int         @default(0) // ลำดับสำหรับจัดเรียงแสดงผล
  photoUrl      String?
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("personnels")
}

model SchoolStat {
  id                     String      @id @default(uuid())
  academicYear           Int         // ปีการศึกษา (พ.ศ.) เช่น 2567, 2568
  semester               Int         @default(1) // ภาคเรียนที่ 1 หรือ 2

  // ข้อมูลสถิตินักเรียนจำแนกเพศ
  maleStudents           Int         @default(0) // นักเรียนชาย
  femaleStudents         Int         @default(0) // นักเรียนหญิง

  // ข้อมูลสถิตินักเรียนจำแนกชั้นปี
  vocCert1               Int         @default(0) // ปวช.1
  vocCert2               Int         @default(0) // ปวช.2
  vocCert3               Int         @default(0) // ปวช.3
  highVocCert1           Int         @default(0) // ปวส.1
  highVocCert2           Int         @default(0) // ปวส.2
  bachelorCount          Int         @default(0) // ปริญญาตรี (ทล.บ.)
  
  // สรุปรวม
  vocCertCount           Int         @default(0) // รวม ปวช.
  highVocCertCount       Int         @default(0) // รวม ปวส.
  totalStudents          Int         @default(0) // รวมนักเรียน/นักศึกษาทั้งหมด
  totalExecutives        Int         @default(1) // จำนวนผู้บริหาร
  totalTeachers          Int         @default(0) // จำนวนครูผู้สอน
  totalStaff             Int         @default(0) // จำนวนบุคลากรทางการศึกษา

  // กลุ่ม 2: สถิตินักเรียนศึกษาต่อ แต่ยังไม่สำเร็จการศึกษา (คน)
  pendingGradM3          Int         @default(0) // นักเรียนที่ยังไม่จบ ม.3
  pendingGradM6          Int         @default(0) // นักเรียนที่ยังไม่จบ ม.6
  pendingGradVoc3        Int         @default(0) // นักเรียนที่ยังไม่จบ ปวช.3

  // กลุ่ม 3: ข้อมูลสารสนเทศด้านการจัดการอาชีวศึกษา
  dveStudentsCount       Int         @default(0) // จำนวนนักเรียนทวิภาคีรวม ที่กำลังศึกษาอยู่
  dualStudyCount         Int         @default(0) // จำนวนนักเรียนทวิศึกษา ที่กำลังศึกษาอยู่ (ม.ปลาย ควบ ปวช.)
  dualDegreeCount        Int         @default(0) // จำนวนนักเรียนทวิวุฒิ ที่กำลังศึกษาอยู่ (Dual Degree)
  fttAssessment          Boolean     @default(false) // เข้าร่วมการประเมิน อวท. ระดับจังหวัด (true = เข้าร่วม, false = ไม่เข้าร่วม)

  // กลุ่ม 4: ข้อมูลบุคลากรทางการศึกษา จำแนกเพศและวุฒิการศึกษา
  maleTeachers           Int         @default(0) // ครู ชาย (คน)
  femaleTeachers         Int         @default(0) // ครู หญิง (คน)
  degreeAssociateMale    Int         @default(0) // อนุปริญญาหรือเทียบเท่า ชาย
  degreeAssociateFemale  Int         @default(0) // อนุปริญญาหรือเทียบเท่า หญิง
  degreeBachelorMale     Int         @default(0) // ปริญญาตรี ชาย
  degreeBachelorFemale   Int         @default(0) // ปริญญาตรี หญิง
  degreeMasterMale       Int         @default(0) // ปริญญาโท ชาย
  degreeMasterFemale     Int         @default(0) // ปริญญาโท หญิง
  degreeDoctorMale       Int         @default(0) // ปริญญาเอก ชาย
  degreeDoctorFemale     Int         @default(0) // ปริญญาเอก หญิง
  civilTeachersMale      Int         @default(0) // ข้าราชการครู ชาย
  civilTeachersFemale    Int         @default(0) // ข้าราชการครู หญิง
  hiredTeachersMale      Int         @default(0) // ครูอัตราจ้าง ชาย
  hiredTeachersFemale    Int         @default(0) // ครูอัตราจ้าง หญิง

  // ข้อมูลผู้สำเร็จการศึกษา
  gradVocCertCount       Int         @default(0) // ปวช. สำเร็จการศึกษา
  gradHighVocCertCount   Int         @default(0) // ปวส. สำเร็จการศึกษา
  employedGraduatesCount Int         @default(0) // บัณฑิตที่มีงานทำรวม
  furtherStudyCount      Int         @default(0) // ศึกษาต่อ
  unemployedCount        Int         @default(0) // ว่างงาน / ยังไม่มีงานทำ

  // จำแนกประเภทการมีงานทำ
  employedInField        Int         @default(0) // ทำงานตรงสาขาวิชาชีพ
  employedOutField       Int         @default(0) // ทำงานไม่ตรงสาขาวิชาชีพ
  employedFreelance      Int         @default(0) // ประกอบอาชีพอิสระ

  // จำแนกหน่วยงานที่เข้าทำงาน
  workGov                Int         @default(0) // หน่วยงานของรัฐ
  workPrivate            Int         @default(0) // หน่วยงานเอกชน
  workSelf               Int         @default(0) // ประกอบอาชีพอิสระ / ธุรกิจส่วนตัว

  institutionId          String
  institution            Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([institutionId, academicYear, semester])
  @@map("school_stats")
}

// กลุ่ม 1: ข้อมูลการจัดการศึกษาระบบทวิภาคีเจาะลึกรายแผนกวิชา
model DveDepartment {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear   Int         // ปีการศึกษา (พ.ศ.)
  semester       Int         @default(1) // ภาคเรียน
  departmentName String      // ชื่อแผนกวิชา เช่น ช่างยนต์, คอมพิวเตอร์ธุรกิจ
  studentCount   Int         @default(0) // จำนวนนักเรียนทวิภาคีในแผนกนี้ (คน)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("dve_departments")
}

// กลุ่ม 5: วิทยาลัยที่เปิดหลักสูตรห้องเรียนอาชีพ (Career Classroom & Reskill/Upskill)
model CareerClassroom {
  id                 String                @id @default(uuid())
  institutionId      String
  institution        Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear       Int                   // ปีการศึกษา (พ.ศ.)
  semester           Int                   @default(1) // ภาคเรียน
  courseName         String                // ชื่อหลักสูตรห้องเรียนอาชีพ
  partnerSchoolCount Int                   @default(0) // จำนวนโรงเรียนเครือข่ายที่เข้าร่วม (Auto-calculated)
  partnerSchoolNames String?               // รายชื่อโรงเรียนเครือข่ายที่เข้าร่วม (Auto-calculated)
  studentCount       Int                   @default(0) // จำนวนนักเรียนที่เข้าร่วม (คน) (Auto-calculated)
  trainingType       String                @default("SHORT_COURSE") // SHORT_COURSE (ฝึกอาชีพระยะสั้น) | RESKILL_UPSKILL (Reskill-Upskill)
  learningFormat     String                @default("ONSITE") // ONSITE (ในสถานศึกษา) | WORKPLACE (ในสถานประกอบการ) | ONLINE (ออนไลน์) | HYBRID (ผสมผสาน)
  partnerSchools     CareerPartnerSchool[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("career_classrooms")
}

// ตารางลูก: รายชื่อโรงเรียนเครือข่ายและยอดนักเรียนรายหัว
model CareerPartnerSchool {
  id                String          @id @default(uuid())
  careerClassroomId String
  careerClassroom   CareerClassroom @relation(fields: [careerClassroomId], references: [id], onDelete: Cascade)
  schoolName        String          // ชื่อโรงเรียนเครือข่าย เช่น รร.อุดรพิทยานุกูล
  studentCount      Int             @default(0) // จำนวนนักเรียนที่เข้าร่วมจากโรงเรียนนี้ (คน)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("career_partner_schools")
}


model News {
  id            String       @id @default(uuid())
  title         String
  content       String       @db.Text
  coverImageUrl String?
  linkUrl       String?
  category      NewsCategory @default(ANNOUNCEMENT)
  isPublished   Boolean      @default(true)
  viewCount     Int          @default(0)
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("news")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique // เช่น is_data_submission_open, system_title
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   // ชื่อ-นามสกุล ผู้ติดต่อ
  email     String   // อีเมล
  phone     String?  // เบอร์โทรศัพท์
  subject   String   // เรื่องที่ติดต่อ
  message   String   @db.Text // ข้อความ
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
